# Defensa en profundidad: si el proyecto completo está en public_html (despliegue actual en Hostinger),
# todo se sirve desde public/ y nada de app/, config/, storage/, vendor/… es accesible.
Options -Indexes -MultiViews
<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS y sin www, ANTES de reescribir a public/ para que la URL pública nunca muestre /public/
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301,NE]
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [L,R=301,NE]

    RewriteRule ^(app|config|database|storage|vendor|cron|tests|tools|docs|\.hostinger)(/|$) - [F,L]
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
