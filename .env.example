# Copia este archivo como .env (fuera de public/) y completa los valores.
# Nunca subas .env al repositorio.

APP_ENV=production            # production | local
APP_DEBUG=false
APP_URL=https://maquillajebucaramanga.com
# 32 bytes aleatorios en base64: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=

# Base de datos (usuario de la aplicación: sin UPDATE/DELETE en tablas de solo inserción)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
# Usuario separado para migraciones (solo consola)
DB_MIGRATE_USER=
DB_MIGRATE_PASS=

# Correo SMTP (Hostinger)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl           # ssl | tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=reservas@maquillajebucaramanga.com
MAIL_FROM_NAME="Make Up by Fletcher"
# log = escribe los correos en storage/logs/mail.log en lugar de enviarlos (desarrollo)
MAIL_DRIVER=smtp

# Destinatarios internos
OWNER_EMAIL=makeupbyfletcher@gmail.com
PARTNER_EMAIL=

# Wompi (llaves de prueba en desarrollo)
WOMPI_ENV=sandbox             # sandbox | production
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Analítica (se carga solo tras el consentimiento)
GTM_ID=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Cloudflare Turnstile (opcional, solo si hay abuso en formularios)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
