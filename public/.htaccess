# Make Up by Fletcher · reglas de Apache (Hostinger)
Options -Indexes -MultiViews
ServerSignature Off
DirectoryIndex index.php

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS obligatorio y sin www. $1 es la ruta relativa a esta carpeta: funciona igual si el
    # DocumentRoot es public/ o si la raíz reescribe hacia public/ (nunca expone «/public/» en la URL)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301,NE]

    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [L,R=301,NE]

    # Bloquear archivos y carpetas ocultas (.env, .git, .htaccess…), salvo .well-known
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    # Bloquear archivos de dependencias y respaldos
    RewriteRule (^|/)(composer\.(json|lock)|package(-lock)?\.json|.*\.(sql|log|bak|ini|sh|md))$ - [F,L]

    # Archivos estáticos existentes de /assets se sirven tal cual
    # (patrón relativo a esta carpeta: funciona en Apache y LiteSpeed, también tras la reescritura de la raíz)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^assets/ - [L]

    # favicon y security.txt
    RewriteRule ^(favicon\.ico|\.well-known/security\.txt)$ - [L]

    # Todo lo demás al front controller (no se sirve ningún otro .php directamente)
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|avif|webp|jpe?g|png|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

AddType font/woff2 .woff2
AddType image/avif .avif
